# Public side of relay and publish on one server (Caddy gets the TLS certificates itself).
# Only the public listeners go through Caddy. The admin pages (relay :8412, publish :8411) and the
# publish private-app listener (<private IP>:80) listen on the private-network address only and never
# get a route here. Caddy binds the public address only, so it never takes port 80 on the private one:
# replace PUBLIC_IP with the server's public address(es) before `caddy validate` (it fails until then).
{
	default_bind PUBLIC_IP
}

relay.severin.io {
	reverse_proxy 127.0.0.1:8103
}

publish.severin.io {
	request_body {
		max_size 110MB
	}
	reverse_proxy 127.0.0.1:8102
}
