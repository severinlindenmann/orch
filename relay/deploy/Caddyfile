# Public side of relay and publish on one server (Caddy gets the TLS certificates itself).
# Only the public listeners go through Caddy. The admin pages (relay :8412, publish :8411) and the
# publish private-app listener listen on the private-network address only and never get a route here.
relay.severin.io {
	reverse_proxy 127.0.0.1:8103
}

publish.severin.io {
	request_body {
		max_size 110MB
	}
	reverse_proxy 127.0.0.1:8102
}
