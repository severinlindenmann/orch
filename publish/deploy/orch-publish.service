[Unit]
Description=orch-publish
After=network-online.target
Wants=network-online.target

[Service]
User=orch-publish
EnvironmentFile=/etc/orch-publish/env
ExecStart=/opt/orch/bin/orch-publish
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/orch-publish /srv/orch-publish

[Install]
WantedBy=multi-user.target
