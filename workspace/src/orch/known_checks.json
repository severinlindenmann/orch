{
  "_doc": "Built-in checks (ORCH-48), since ORCH-529 a library of templates: a workspace adds the ones it needs as check files (orch checks add <name> [--profile X], checkfiles.py). Only a workspace without a .orch/checks folder still runs them by itself (the old way, for one release): each only when the tool is installed AND one of its set_if files exists or env_if names is set. profile: the per-profile form (label, command, sign_in with {profile}), one check per profile, so an unused or expired other profile never warns. No end date from these tools: the exit code answers and what the command prints is never read. sign_in is the terminal command the warning shows with a Copy button (ORCH-218); orch never runs it.",
  "checks": {
    "github": {
      "label": "GitHub",
      "command": ["gh", "auth", "status"],
      "set_if": ["{config}/gh/hosts.yml", "{appdata}/GitHub CLI/hosts.yml"],
      "env_if": ["GH_TOKEN", "GITHUB_TOKEN", "GH_CONFIG_DIR"],
      "sign_in": "gh auth login"
    },
    "databricks": {
      "label": "Databricks",
      "command": ["databricks", "auth", "profiles", "--output", "json"],
      "works": "profiles.*.valid",
      "set_if": ["{home}/.databrickscfg"],
      "env_if": ["DATABRICKS_CONFIG_FILE"],
      "sign_in": "databricks auth login",
      "profile": {
        "label": "Databricks {profile}",
        "command": ["databricks", "current-user", "me", "--profile", "{profile}"],
        "sign_in": "databricks auth login --profile {profile}"
      }
    },
    "azure": {
      "label": "Azure CLI",
      "command": ["az", "account", "get-access-token", "--query", "expiresOn", "--output", "tsv"],
      "set_if": ["{home}/.azure/azureProfile.json"],
      "env_if": ["AZURE_CONFIG_DIR"],
      "sign_in": "az login"
    },
    "gcloud": {
      "label": "Google Cloud CLI",
      "command": ["gcloud", "auth", "print-access-token", "--quiet"],
      "set_if": ["{config}/gcloud/credentials.db", "{appdata}/gcloud/credentials.db"],
      "env_if": ["CLOUDSDK_CONFIG"],
      "sign_in": "gcloud auth login"
    },
    "aws": {
      "label": "AWS CLI",
      "command": ["aws", "sts", "get-caller-identity"],
      "set_if": ["{home}/.aws/config", "{home}/.aws/credentials"],
      "env_if": ["AWS_CONFIG_FILE", "AWS_SHARED_CREDENTIALS_FILE", "AWS_PROFILE"],
      "sign_in": "aws sso login",
      "profile": {
        "label": "AWS {profile}",
        "command": ["aws", "sts", "get-caller-identity", "--profile", "{profile}"],
        "sign_in": "aws sso login --profile {profile}"
      }
    }
  }
}
