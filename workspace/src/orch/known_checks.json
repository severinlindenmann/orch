{
  "_doc": "Other tools a helper often needs (health.known_recipes, ORCH-48). Same entry as a workspace's own check (orch logins add), plus set_if / env_if: the check only runs when the tool is installed AND one of these settings files exists or environment names is set, so an unused tool never warns. No end date from these tools: orch says only whether the login works; the exit code answers and what the command prints is never read. sign_in is the terminal command the warning shows with a Copy button (ORCH-218); orch never runs it.",
  "checks": {
    "github": {
      "label": "GitHub",
      "command": ["gh", "auth", "status"],
      "set_if": ["{config}/gh/hosts.yml", "{appdata}/GitHub CLI/hosts.yml"],
      "env_if": ["GH_TOKEN", "GITHUB_TOKEN", "GH_CONFIG_DIR"],
      "sign_in": "gh auth login"
    },
    "databricks": {
      "label": "Databricks",
      "command": ["databricks", "auth", "profiles", "--output", "json"],
      "works": "profiles.*.valid",
      "set_if": ["{home}/.databrickscfg"],
      "env_if": ["DATABRICKS_CONFIG_FILE"],
      "sign_in": "databricks auth login"
    },
    "azure": {
      "label": "Azure CLI",
      "command": ["az", "account", "get-access-token", "--query", "expiresOn", "--output", "tsv"],
      "set_if": ["{home}/.azure/azureProfile.json"],
      "env_if": ["AZURE_CONFIG_DIR"],
      "sign_in": "az login"
    },
    "gcloud": {
      "label": "Google Cloud CLI",
      "command": ["gcloud", "auth", "print-access-token", "--quiet"],
      "set_if": ["{config}/gcloud/credentials.db", "{appdata}/gcloud/credentials.db"],
      "env_if": ["CLOUDSDK_CONFIG"],
      "sign_in": "gcloud auth login"
    },
    "aws": {
      "label": "AWS CLI",
      "command": ["aws", "sts", "get-caller-identity"],
      "set_if": ["{home}/.aws/config", "{home}/.aws/credentials"],
      "env_if": ["AWS_CONFIG_FILE", "AWS_SHARED_CREDENTIALS_FILE", "AWS_PROFILE"],
      "sign_in": "aws sso login"
    }
  }
}
