          },
          "allOf": [
            { "if": { "properties": { "on": { "const": true } } },
              "then": { "required": ["since", "ends_at", "machine"], "properties": { "since": { "type": "string" }, "ends_at": { "type": "string" }, "machine": { "type": "string" } }, "not": { "required": ["ended"] } },
