    "heartbeat_request": {
      "description": "POST /v1/heartbeat (workspace auth). on=true: since, ends_at, machine required, no ended. on=false: since/ends_at/machine null or left out, optional ended.",
      "type": "object", "required": ["mobile_mode"],
      "properties": {
        "mobile_mode": {
          "type": "object", "required": ["on"],
          "properties": {
            "on": { "type": "boolean" },
            "since": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
            "ends_at": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
