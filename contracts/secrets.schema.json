{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orch.severin.io/contracts/secrets.schema.json",
  "title": "orch keys v1: profiles.toml, keys.json, orch secret list --json",
  "description": "See secrets.md. Keys live in orch's own per-user folder, never in the workspace. Profiles hold names only. No schema here ever carries a key value except $defs/key_entry, which is only ever read from the owner-only store file.",
  "$defs": {
    "key_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profile_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
      "not": {
        "anyOf": [
          {
            "pattern": "^([Aa][Ll][Ll]_[Pp][Rr][Oo][Xx][Yy]|[Aa][Pp][Pp][Dd][Aa][Tt][Aa]|[Bb][Aa][Ss][Hh][Oo][Pp][Tt][Ss]|[Bb][Aa][Ss][Hh]_[Ee][Nn][Vv]|[Bb][Rr][Oo][Ww][Ss][Ee][Rr]|[Cc][Oo][Mm][Ss][Pp][Ee][Cc]|[Cc][Uu][Rr][Ll]_[Cc][Aa]_[Bb][Uu][Nn][Dd][Ll][Ee]|[Dd][Oo][Tt][Nn][Ee][Tt]_[Ss][Tt][Aa][Rr][Tt][Uu][Pp]_[Hh][Oo][Oo][Kk][Ss]|[Ee][Dd][Ii][Tt][Oo][Rr]|[Ee][Nn][Vv]|[Gg][Cc][Oo][Nn][Vv]_[Pp][Aa][Tt][Hh]|[Gg][Ll][Ii][Bb][Cc]_[Tt][Uu][Nn][Aa][Bb][Ll][Ee][Ss]|[Hh][Oo][Mm][Ee]|[Hh][Tt][Tt][Pp][Ss]_[Pp][Rr][Oo][Xx][Yy]|[Hh][Tt][Tt][Pp]_[Pp][Rr][Oo][Xx][Yy]|[Ii][Ff][Ss]|[Jj][Aa][Vv][Aa]_[Tt][Oo][Oo][Ll]_[Oo][Pp][Tt][Ii][Oo][Nn][Ss]|[Ll][Ee][Ss][Ss][Oo][Pp][Ee][Nn]|[Ll][Oo][Cc][Pp][Aa][Tt][Hh]|[Ll][Uu][Aa]_[Ii][Nn][Ii][Tt]|[Ll][Uu][Aa]_[Pp][Aa][Tt][Hh]|[Nn][Oo][Dd][Ee]_[Ee][Xx][Tt][Rr][Aa]_[Cc][Aa]_[Cc][Ee][Rr][Tt][Ss]|[Nn][Oo][Dd][Ee]_[Oo][Pp][Tt][Ii][Oo][Nn][Ss]|[Nn][Oo]_[Pp][Rr][Oo][Xx][Yy]|[Nn][Pp][Mm]_[Cc][Oo][Nn][Ff][Ii][Gg]_[Ss][Cc][Rr][Ii][Pp][Tt]_[Ss][Hh][Ee][Ll][Ll]|[Oo][Rr][Cc][Hh]_[Bb][Ii][Nn]|[Oo][Rr][Cc][Hh]_[Ee][Vv][Ee][Nn][Tt][Ss]|[Oo][Rr][Cc][Hh]_[Hh][Oo][Mm][Ee]|[Oo][Rr][Cc][Hh]_[Jj][Oo][Bb]|[Oo][Rr][Cc][Hh]_[Rr][Oo][Oo][Tt]|[Oo][Rr][Cc][Hh]_[Rr][Uu][Nn]|[Pp][Aa][Gg][Ee][Rr]|[Pp][Aa][Tt][Hh]|[Pp][Aa][Tt][Hh][Ee][Xx][Tt]|[Pp][Ee][Rr][Ll]5[Oo][Pp][Tt]|[Pp][Ee][Rr][Ll][Ll][Ii][Bb]|[Pp][Rr][Oo][Mm][Pp][Tt]_[Cc][Oo][Mm][Mm][Aa][Nn][Dd]|[Pp][Ss]4|[Pp][Yy][Tt][Hh][Oo][Nn][Hh][Oo][Mm][Ee]|[Pp][Yy][Tt][Hh][Oo][Nn][Pp][Aa][Tt][Hh]|[Pp][Yy][Tt][Hh][Oo][Nn][Ss][Tt][Aa][Rr][Tt][Uu][Pp]|[Rr][Ee][Qq][Uu][Ee][Ss][Tt][Ss]_[Cc][Aa]_[Bb][Uu][Nn][Dd][Ll][Ee]|[Rr][Uu][Bb][Yy][Oo][Pp][Tt]|[Rr][Uu][Ss][Tt][Cc]_[Ww][Rr][Aa][Pp][Pp][Ee][Rr]|[Ss][Hh][Ee][Ll][Ll]|[Ss][Hh][Ee][Ll][Ll][Oo][Pp][Tt][Ss]|[Ss][Ss][Ll]_[Cc][Ee][Rr][Tt]_[Dd][Ii][Rr]|[Ss][Ss][Ll]_[Cc][Ee][Rr][Tt]_[Ff][Ii][Ll][Ee]|[Ss][Yy][Ss][Tt][Ee][Mm][Rr][Oo][Oo][Tt]|[Uu][Ss][Ee][Rr][Pp][Rr][Oo][Ff][Ii][Ll][Ee]|[Zz][Dd][Oo][Tt][Dd][Ii][Rr]|_[Jj][Aa][Vv][Aa]_[Oo][Pp][Tt][Ii][Oo][Nn][Ss])$"
          },
          {
            "pattern": "^([Ll][Dd]_|[Dd][Yy][Ll][Dd]_|[Gg][Ii][Tt]_|[Oo][Rr][Cc][Hh]_|[Pp][Yy][Tt][Hh][Oo][Nn]|[Pp][Ee][Rr][Ll]5|[Rr][Uu][Bb][Yy]|[Nn][Oo][Dd][Ee]_|[Cc][Oo][Rr]_[Pp][Rr][Oo][Ff][Ii][Ll][Ee][Rr]|[Cc][Oo][Rr][Ee][Cc][Ll][Rr]_)"
          },
          {
            "pattern": "_[Oo][Pp][Tt][Ii][Oo][Nn][Ss]$"
          }
        ]
      },
      "description": "Variables that change how programs load, which shell or interpreter runs, where a program looks for its home or config, or which orch runs are refused, in any letter case (W2b): PATH, HOME, LD_*, DYLD_*, GIT_*, ORCH_*, PYTHON*, PERL5*, RUBY*, NODE_*, COR_PROFILER*, CORECLR_*, *_OPTIONS, SHELLOPTS, PS4, BASH_ENV, ENV, IFS, PATHEXT, COMSPEC, proxies, CA bundles, EDITOR, PAGER, and the like (keystore.ENV_DENY)."
    },
    "key_type": {
      "enum": [
        "token",
        "password",
        "key-file",
        "json"
      ]
    },
    "source": {
      "enum": [
        "workspace",
        "admin"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$"
    },
    "profiles": {
      "type": "object",
      "required": [
        "schema",
        "profile"
      ],
      "additionalProperties": false,
      "description": "<orch home>/keys/<workspace local id>/profiles.toml, parsed. Names only: never a value.",
      "properties": {
        "schema": {
          "const": "orch.secret-profiles/1"
        },
        "profile": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/profile_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "env"
          ]
        },
        {
          "required": [
            "files"
          ]
        }
      ],
      "properties": {
        "env": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/env_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key_name"
          },
          "description": "Variable -> key name: the value is put in the variable (orch secret env, exec)."
        },
        "files": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/env_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key_name"
          },
          "description": "Variable -> key name: the value is written to a temporary owner-only file and the variable holds its path (orch secret file, exec)."
        },
        "set": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/env_name"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "description": "Plain settings that are not secret (a host name). Shown in the clear."
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": "The one command `orch secret exec <profile>` runs (argv, no shell). Needed for exec; MCP servers start only this way."
        },
        "allow_get": {
          "type": "boolean",
          "default": false,
          "description": "orch secret get works for the keys of this profile. Off by default."
        },
        "agents_may_env": {
          "type": "boolean",
          "default": false,
          "description": "Screen wording: \"Let agents use these keys in any command\". Off by default: an agent's `orch secret env|file` then runs only the profile's own `run` command, exactly. Counts only with a matching settings record (secret.agents_may_env.<profile>, set with a secret.profile proof)."
        },
        "skills": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "description": "Skills expected to use it (recorded, shown in Insights; not enforced: Level 1)."
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "key_entry": {
      "type": "object",
      "required": [
        "type",
        "source",
        "added_at"
      ],
      "additionalProperties": false,
      "description": "One entry of keys.json (0600). token/password/json carry value; key-file carries file (a name inside files/).",
      "properties": {
        "type": {
          "$ref": "#/$defs/key_type"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "value": {
          "type": "string",
          "minLength": 8,
          "maxLength": 65536
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "added_at": {
          "$ref": "#/$defs/time"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "key-file"
              }
            }
          },
          "then": {
            "required": [
              "file"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "file"
              ]
            }
          }
        }
      ]
    },
    "keys_file": {
      "type": "object",
      "required": [
        "schema",
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "orch.keys/1"
        },
        "keys": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key_entry"
          }
        }
      }
    },
    "list_item": {
      "type": "object",
      "required": [
        "name",
        "type",
        "source",
        "profiles",
        "state",
        "last_used",
        "uses_7d",
        "shadowed"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/key_name"
        },
        "type": {
          "$ref": "#/$defs/key_type"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_name"
          }
        },
        "state": {
          "enum": [
            "ok",
            "missing",
            "refused",
            "unused",
            "managed",
            "needs-reentry"
          ],
          "description": "missing = a profile names it but no key has that name; refused = refused by its profile in the last 7 days; unused = not used for 60 days; managed = admin key (read-only here); needs-reentry = its file had loose rights and was set aside, the key must be entered again."
        },
        "last_used": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "uses_7d": {
          "type": "integer",
          "minimum": 0
        },
        "shadowed": {
          "type": "boolean",
          "description": "true = an admin key with the same name as a workspace key; the workspace key is used."
        }
      }
    },
    "list_answer": {
      "type": "object",
      "required": [
        "items",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
