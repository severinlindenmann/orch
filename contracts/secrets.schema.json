{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orch.severin.io/contracts/secrets.schema.json",
  "title": "orch keys v1: profiles.toml, keys.json, orch secret list --json",
  "description": "See secrets.md. Keys live in orch's own per-user folder, never in the workspace. Profiles hold names only. No schema here ever carries a key value except $defs/key_entry, which is only ever read from the owner-only store file.",
  "$defs": {
    "key_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profile_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
      "not": {
        "anyOf": [
          {
            "enum": [
              "PATH",
              "HOME",
              "SHELL",
              "ENV",
              "BASH_ENV",
              "IFS",
              "NODE_OPTIONS",
              "PYTHONPATH",
              "PYTHONHOME",
              "PYTHONSTARTUP",
              "PERL5OPT",
              "RUBYOPT",
              "ORCH_BIN",
              "ORCH_EVENTS",
              "ORCH_RUN",
              "ORCH_JOB",
              "ORCH_HOME",
              "ORCH_ROOT",
              "HTTP_PROXY",
              "HTTPS_PROXY",
              "ALL_PROXY",
              "NO_PROXY",
              "http_proxy",
              "https_proxy",
              "all_proxy",
              "SSL_CERT_FILE",
              "SSL_CERT_DIR",
              "NODE_EXTRA_CA_CERTS",
              "REQUESTS_CA_BUNDLE",
              "CURL_CA_BUNDLE",
              "JAVA_TOOL_OPTIONS",
              "_JAVA_OPTIONS"
            ]
          },
          {
            "pattern": "^(LD_|DYLD_|GIT_|ORCH_)"
          }
        ]
      },
      "description": "Variables that change how programs load or which orch runs are refused."
    },
    "key_type": {
      "enum": [
        "token",
        "password",
        "key-file",
        "json"
      ]
    },
    "source": {
      "enum": [
        "workspace",
        "admin"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$"
    },
    "profiles": {
      "type": "object",
      "required": [
        "schema",
        "profile"
      ],
      "additionalProperties": false,
      "description": "<orch home>/keys/<workspace local id>/profiles.toml, parsed. Names only: never a value.",
      "properties": {
        "schema": {
          "const": "orch.secret-profiles/1"
        },
        "profile": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/profile_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "env"
          ]
        },
        {
          "required": [
            "files"
          ]
        }
      ],
      "properties": {
        "env": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/env_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key_name"
          },
          "description": "Variable -> key name: the value is put in the variable (orch secret env, exec)."
        },
        "files": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/env_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key_name"
          },
          "description": "Variable -> key name: the value is written to a temporary owner-only file and the variable holds its path (orch secret file, exec)."
        },
        "set": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/env_name"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "description": "Plain settings that are not secret (a host name). Shown in the clear."
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": "The one command `orch secret exec <profile>` runs (argv, no shell). Needed for exec; MCP servers start only this way."
        },
        "allow_get": {
          "type": "boolean",
          "default": false,
          "description": "orch secret get works for the keys of this profile. Off by default."
        },
        "skills": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "description": "Skills expected to use it (recorded, shown in Insights; not enforced: Level 1)."
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "key_entry": {
      "type": "object",
      "required": [
        "type",
        "source",
        "added_at"
      ],
      "additionalProperties": false,
      "description": "One entry of keys.json (0600). token/password/json carry value; key-file carries file (a name inside files/).",
      "properties": {
        "type": {
          "$ref": "#/$defs/key_type"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "value": {
          "type": "string",
          "minLength": 8,
          "maxLength": 65536
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "added_at": {
          "$ref": "#/$defs/time"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "key-file"
              }
            }
          },
          "then": {
            "required": [
              "file"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "file"
              ]
            }
          }
        }
      ]
    },
    "keys_file": {
      "type": "object",
      "required": [
        "schema",
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "orch.keys/1"
        },
        "keys": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key_entry"
          }
        }
      }
    },
    "list_item": {
      "type": "object",
      "required": [
        "name",
        "type",
        "source",
        "profiles",
        "state",
        "last_used",
        "uses_7d",
        "shadowed"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/key_name"
        },
        "type": {
          "$ref": "#/$defs/key_type"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile_name"
          }
        },
        "state": {
          "enum": [
            "ok",
            "missing",
            "refused",
            "unused",
            "managed"
          ],
          "description": "missing = a profile names it but no key has that name; refused = refused by its profile in the last 7 days; unused = not used for 60 days; managed = admin key (read-only here)."
        },
        "last_used": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/time"
            }
          ]
        },
        "uses_7d": {
          "type": "integer",
          "minimum": 0
        },
        "shadowed": {
          "type": "boolean",
          "description": "true = an admin key with the same name as a workspace key; the workspace key is used."
        }
      }
    },
    "list_answer": {
      "type": "object",
      "required": [
        "items",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
