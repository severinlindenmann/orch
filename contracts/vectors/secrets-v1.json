{
 "v": 1,
 "about": "secrets.md reference cases. Values are fake. validate.py secrets checks hide both on the joined text and streamed chunk by chunk (sec_hide, sec_hide_stream).",
 "hide": [
  {
   "name": "plain value",
   "keys": [
    {
     "name": "databricks-token",
     "type": "token",
     "value": "fake-token-Q7xP2mK9vL4"
    }
   ],
   "chunks": [
    "Using token fake-token-Q7xP2mK9vL4 for the call"
   ],
   "expect": "Using token [hidden: databricks-token] for the call"
  },
  {
   "name": "split in 3-char chunks",
   "keys": [
    {
     "name": "databricks-token",
     "type": "token",
     "value": "fake-token-Q7xP2mK9vL4"
    }
   ],
   "chunks": [
    "aut",
    "h: ",
    "Bea",
    "rer",
    " fa",
    "ke-",
    "tok",
    "en-",
    "Q7x",
    "P2m",
    "K9v",
    "L4\n",
    "ok"
   ],
   "expect": "auth: Bearer [hidden: databricks-token]\nok"
  },
  {
   "name": "split right inside the value",
   "keys": [
    {
     "name": "databricks-token",
     "type": "token",
     "value": "fake-token-Q7xP2mK9vL4"
    }
   ],
   "chunks": [
    "Bearer fake-tok",
    "en-Q7xP2",
    "mK9vL4 done"
   ],
   "expect": "Bearer [hidden: databricks-token] done"
  },
  {
   "name": "value at the very end of the stream",
   "keys": [
    {
     "name": "databricks-token",
     "type": "token",
     "value": "fake-token-Q7xP2mK9vL4"
    }
   ],
   "chunks": [
    "end ",
    "fake-",
    "token-Q7xP2mK9vL4"
   ],
   "expect": "end [hidden: databricks-token]"
  },
  {
   "name": "json escaped form",
   "keys": [
    {
     "name": "db-password",
     "type": "password",
     "value": "pa\"ss\\word-2026"
    }
   ],
   "chunks": [
    "{\"password\": \"pa\\\"ss\\\\word-2026\"}"
   ],
   "expect": "{\"password\": \"[hidden: db-password]\"}"
  },
  {
   "name": "url encoded form",
   "keys": [
    {
     "name": "smtp-password",
     "type": "password",
     "value": "p@ss w/rd 2026!"
    }
   ],
   "chunks": [
    "https://mail.example/login?pw=p%40ss%20w%2Frd%202026%21"
   ],
   "expect": "https://mail.example/login?pw=[hidden: smtp-password]"
  },
  {
   "name": "base64 form",
   "keys": [
    {
     "name": "databricks-token",
     "type": "token",
     "value": "fake-token-Q7xP2mK9vL4"
    }
   ],
   "chunks": [
    "Authorization: Basic ZmFrZS10b2tlbi1RN3hQMm1LOXZMNA=="
   ],
   "expect": "Authorization: Basic [hidden: databricks-token]"
  },
  {
   "name": "json key file leaves and pem lines",
   "keys": [
    {
     "name": "google-sa.json",
     "type": "json",
     "value": {
      "type": "service_account",
      "client_email": "bot@example-project.iam.example",
      "private_key_id": "0f1e2d3c4b5a69788796a5b4",
      "private_key": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC\nBKcwggSjAgEAAoIBAQC7FAKEFAKEFAKE\n-----END PRIVATE KEY-----\n"
     }
    }
   ],
   "chunks": [
    "loaded ",
    "bot@exa",
    "mple-pr",
    "oject.i",
    "am.exam",
    "ple key",
    " line M",
    "IIEvQIB",
    "ADANBgk",
    "qhkiG9w",
    "0BAQEFA",
    "ASC and",
    " id 0f1",
    "e2d3c4b",
    "5a69788",
    "796a5b4"
   ],
   "expect": "loaded [hidden: google-sa.json] key line [hidden: google-sa.json] and id [hidden: google-sa.json]"
  },
  {
   "name": "longer value wins",
   "keys": [
    {
     "name": "short-token",
     "type": "token",
     "value": "abcd1234"
    },
    {
     "name": "long-token",
     "type": "token",
     "value": "abcd1234-extended-99"
    }
   ],
   "chunks": [
    "a abcd1234-extended-99 b abcd1234 c"
   ],
   "expect": "a [hidden: long-token] b [hidden: short-token] c"
  },
  {
   "name": "error text and traceback",
   "keys": [
    {
     "name": "databricks-token",
     "type": "token",
     "value": "fake-token-Q7xP2mK9vL4"
    }
   ],
   "chunks": [
    "Traceback (most recent call last):\n  File \"run.py\", line 3\nRuntimeError: 401 for token fake-token-Q7xP2mK9vL4\n"
   ],
   "expect": "Traceback (most recent call last):\n  File \"run.py\", line 3\nRuntimeError: 401 for token [hidden: databricks-token]\n"
  },
  {
   "name": "no keys, text unchanged",
   "keys": [],
   "chunks": [
    "nothing secret here, 12345678"
   ],
   "expect": "nothing secret here, 12345678"
  }
 ],
 "get": [
  {
   "name": "off by default",
   "allow_get": false,
   "key_in_profile": true,
   "stdout_tty": false,
   "result": "get_off"
  },
  {
   "name": "to a terminal",
   "allow_get": true,
   "key_in_profile": true,
   "stdout_tty": true,
   "result": "get_to_terminal"
  },
  {
   "name": "key not in profile",
   "allow_get": true,
   "key_in_profile": false,
   "stdout_tty": false,
   "result": "not_in_profile"
  },
  {
   "name": "script pipe",
   "allow_get": true,
   "key_in_profile": true,
   "stdout_tty": false,
   "result": "ok"
  }
 ],
 "resolve": [
  {
   "name": "workspace wins over admin",
   "entries": [
    {
     "name": "stripe-key",
     "source": "admin"
    },
    {
     "name": "stripe-key",
     "source": "workspace"
    },
    {
     "name": "google-sa.json",
     "source": "admin"
    }
   ],
   "expect": {
    "used": {
     "google-sa.json": "admin",
     "stripe-key": "workspace"
    },
    "shadowed": [
     "stripe-key"
    ]
   }
  },
  {
   "name": "workspace first",
   "entries": [
    {
     "name": "stripe-key",
     "source": "workspace"
    },
    {
     "name": "stripe-key",
     "source": "admin"
    }
   ],
   "expect": {
    "used": {
     "stripe-key": "workspace"
    },
    "shadowed": [
     "stripe-key"
    ]
   }
  }
 ],
 "too_short": [
  {
   "value": "1234567",
   "stored": false
  },
  {
   "value": "12345678",
   "stored": true
  }
 ]
}