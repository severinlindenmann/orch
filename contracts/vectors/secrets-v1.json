 "resolve": [
  {
   "name": "workspace wins over admin",
   "entries": [
    {
     "name": "stripe-key",
     "source": "admin"
    },
    {
     "name": "stripe-key",
     "source": "workspace"
    },
    {
     "name": "google-sa.json",
     "source": "admin"
    }
   ],
   "expect": {
    "used": {
     "google-sa.json": "admin",
     "stripe-key": "workspace"
    },
    "shadowed": [
     "stripe-key"
    ]
   }
  },
  {
   "name": "workspace first",
   "entries": [
    {
     "name": "stripe-key",
     "source": "workspace"
    },
    {
     "name": "stripe-key",
     "source": "admin"
    }
   ],
   "expect": {
    "used": {
     "stripe-key": "workspace"
    },
    "shadowed": [
     "stripe-key"
    ]
   }
  }
 ],
 "min_len": [
  {
   "value": "1234567",
   "hidden": false,
