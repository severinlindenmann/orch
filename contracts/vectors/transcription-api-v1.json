      "relay": {"error": "unavailable"}
    },
    {
      "name": "busy",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/wav", "body": "tone_1s"},
      "response": {"status": 503, "body": {"error": "busy", "message": "The transcription service is busy. Try again in a minute."}},
      "service": "none",
      "relay": {"error": "unavailable"}
    },
    {
      "name": "job_created",
      "request": {"method": "POST", "path": "/v1/jobs", "token": true, "content_type": "application/octet-stream", "job_key": true, "body": "job_tone_1s"},
