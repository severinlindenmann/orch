{
  "description": "transcription-api.md v1: request/response pairs between a caller (the relay, a workspace) and orch-transcription. validate.py checks every body against transcription-api.schema.json. The service replays every pair whose `service` is `exact` (same status and body with the fake engine, which answers 'hello world' / 'en') or `shape` (same status, same error code, same field names); `none` = the service cannot be made to answer it on demand (limits, load, a newer service). The relay replays every POST /v1/transcribe pair against a stand-in service and must read it as `relay` says: the transcript it passes on (text trimmed), or `unavailable` / `too_large` / `unreadable`. Request bodies: `tone_1s` = 1 s 16 kHz mono 16-bit WAV, 300 Hz tone at 0.3; `silence_1s` = the same, all zero; `garbage` = 64 bytes 0x01; `empty` = no bytes; `over_10mb` = 10 MB + 1 bytes 0x01; `job_tone_1s` = tone_1s sealed as OPF1 (name 'rec', type audio/wav) with the job key; `none` = no body. `token` false = no Authorization header; `job_key` true = X-Orch-Job-Key with the job key.",
  "relay_sends_types": ["audio/m4a", "audio/x-m4a", "audio/mp4", "audio/wav", "audio/x-wav", "audio/webm"],
  "exchanges": [
    {
      "name": "health",
      "request": {"method": "GET", "path": "/v1/health", "token": false, "body": "none"},
      "response": {"status": 200, "body": {"ok": true, "version": "0.1.0"}},
      "service": "shape"
    },
    {
      "name": "short_speech",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/wav", "body": "tone_1s"},
      "response": {"status": 200, "body": {"text": "hello world", "language": "en", "duration": 1.0}},
      "service": "exact",
      "relay": {"transcript": {"text": "hello world", "language": "en", "duration": 1.0}}
    },
    {
      "name": "short_content_type_with_parameters",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/wav; codecs=1", "body": "tone_1s"},
      "response": {"status": 200, "body": {"text": "hello world", "language": "en", "duration": 1.0}},
      "service": "exact",
      "relay": {"transcript": {"text": "hello world", "language": "en", "duration": 1.0}}
    },
    {
      "name": "short_silence_no_language",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/wav", "body": "silence_1s"},
      "response": {"status": 200, "body": {"text": "", "language": null, "duration": 1.0}},
      "service": "exact",
      "relay": {"transcript": {"text": "", "language": null, "duration": 1.0}}
    },
    {
      "name": "short_silence_swiss_german_given",
      "request": {"method": "POST", "path": "/v1/transcribe?language=de-CH", "token": true, "content_type": "audio/wav", "body": "silence_1s"},
      "response": {"status": 200, "body": {"text": "", "language": "de", "duration": 1.0}},
      "service": "exact",
      "relay": {"transcript": {"text": "", "language": "de", "duration": 1.0}}
    },
    {
      "name": "short_spaces_and_a_newer_field",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/m4a", "body": "garbage"},
      "response": {"status": 200, "body": {"text": " hallo zäme ", "language": "de", "duration": 1.25, "words": [{"w": "hallo", "start": 0.1}]}},
      "service": "none",
      "relay": {"transcript": {"text": "hallo zäme", "language": "de", "duration": 1.25}}
    },
    {
      "name": "no_token",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": false, "content_type": "audio/wav", "body": "tone_1s"},
      "response": {"status": 401, "body": {"error": "unauthorized", "message": "Missing or wrong token. Ask the admin of the transcription service for a token."}},
      "service": "shape",
      "relay": {"error": "unavailable"}
    },
    {
      "name": "unknown_type",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "text/plain", "body": "tone_1s"},
      "response": {"status": 415, "body": {"error": "unsupported_audio", "message": "The audio could not be read. Send m4a, wav, webm, ogg, mp3 or flac."}},
      "service": "shape",
      "relay": {"error": "unreadable"}
    },
    {
      "name": "unreadable_audio",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/wav", "body": "garbage"},
      "response": {"status": 415, "body": {"error": "unsupported_audio", "message": "The audio could not be read. Send m4a, wav, webm, ogg, mp3 or flac."}},
      "service": "shape",
      "relay": {"error": "unreadable"}
    },
    {
      "name": "empty_audio",
      "request": {"method": "POST", "path": "/v1/transcribe", "token": true, "content_type": "audio/wav", "body": "empty"},
      "response": {"status": 422, "body": {"error": "invalid", "message": "The audio is empty."}},
      "service": "shape",
      "relay": {"error": "unreadable"}
    },
    {
      "name": "unknown_language",
      "request": {"method": "POST", "path": "/v1/transcribe?language=xx", "token": true, "content_type": "audio/wav", "body": "tone_1s"},
