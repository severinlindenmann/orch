{
  "schema": "orch.tokens/1",
  "mode": "dark-only",
  "color": {
    "bg": "#101216",
    "sidebar": "#0c0e11",
    "surface": "#181b20",
    "surface-2": "#20242b",
    "surface-3": "#2a3038",
    "border": "#30363f",
    "border-strong": "#79838f",
    "input": "var(--border-strong)",
    "text": "#edf0f3",
    "text-muted": "#b2bac5",
    "text-faint": "#a0aab6",
    "brand": "#61d5b8",
    "brand-strong": "#80e2c9",
    "on-brand": "#092b23",
    "brand-soft": "#173c33",
    "info": "#8fbef5",
    "info-soft": "#223347",
    "warning": "#e5be72",
    "warning-soft": "#3b3120",
    "success": "#98cda3",
    "success-soft": "#26392b",
    "danger": "#f3a3a5",
    "danger-soft": "#40292e",
    "working": "var(--info)",
    "needs-you": "var(--warning)",
    "review": "var(--warning)",
    "done": "var(--success)",
    "paused": "var(--text-muted)",
    "failed": "var(--danger)",
    "disabled-bg": "var(--surface-2)",
    "disabled-text": "var(--text-faint)",
    "disabled-border": "var(--border)",
    "focus-ring": "0 0 0 2px var(--bg), 0 0 0 4px var(--brand)",
    "nav-selected": "var(--surface-2)",
    "nav-selected-border": "transparent",
    "scrim": "rgb(0 0 0 / 0.65)",
    "addon": "var(--brand)",
    "on-addon": "var(--on-brand)",
    "addon-soft": "var(--surface-2)",
    "addon-border": "var(--border)",
    "addon-text": "var(--text-muted)",
    "brand-chip-text": "var(--brand)",
    "risk-bar": "var(--warning)",
    "risk-danger-bar": "var(--danger)",
    "add-bg": "var(--success-soft)",
    "del-bg": "var(--danger-soft)",
    "chart-4": "#c3a8f5"
  },
  "font": {
    "font-ui": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "font-mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
  },
  "size": {
    "fs-body": 14, "fs-meta": 12, "fs-eyebrow": 12, "fs-title": 28,
    "space-0": 2, "row-height": 40, "control-height": 36, "card-padding": 16,
    "sidebar-width": 232, "topbar-height": 56, "page-gutter": 24, "content-width": 1280, "panel-width": 296
  },
  "layout": {"reading-width": "76ch"},
  "code": {
    "tok-keyword": "#ff7b72",
    "tok-const": "#79c0ff",
    "tok-string": "#a5d6ff",
    "tok-tag": "#7ee787",
    "tok-func": "#d2a8ff",
    "tok-name": "#ffa657",
    "tok-comment": "#a0aab6",
    "tok-invalid": "#ffa198"
  },
  "type": {"meta": 12, "compact": 14, "body": 14, "section": 20, "title": 28},
  "space": [4, 8, 12, 16, 24, 32, 40, 48, 64],
  "radius": {"sm": 8, "md": 10},
  "button": {"height": 36, "touch": 44},
  "motion": {
    "dur-fast": "100ms",
    "dur-base": "150ms",
    "dur-settle": "200ms",
    "dur-slow": "240ms",
    "dur-exit": "120ms",
    "ease-enter": "cubic-bezier(0, 0.4, 0, 1)",
    "ease-out": "var(--ease-enter)",
    "ease-exit": "cubic-bezier(0.6, 0, 0.8, 0.6)",
    "ease-move": "cubic-bezier(0.4, 0, 0, 1)",
    "shadow": "0 16px 48px rgb(0 0 0 / 0.4)",
    "lift-shadow": "0 8px 24px rgb(0 0 0 / 0.4)"
  }
