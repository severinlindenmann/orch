{
 "lane": "A",
 "title": "Workspace A browser walk (Pilatus dashboard)",
 "base": "pilatus",
 "viewports": [
  1280,
  720,
  390
 ],
 "census_skip": [
  "\\|switch\\|",
  "Turn on",
  "\\|Stop",
  "Change the status"
 ],
 "steps": [
  {
   "id": "A01",
   "name": "Home empty state and title",
   "quick": true,
   "page": "home",
   "tags": [
    "win"
   ],
   "expect": "Home says Needs you and the Today heading; no console error",
   "actions": [
    {
     "do": "goto",
     "path": "/"
    },
    {
     "do": "expect_text",
     "text": "Needs you"
    },
    {
     "do": "expect_text",
     "text": "New ticket"
    }
   ]
  },
  {
   "id": "A02",
   "name": "Menu: open every nav item",
   "quick": true,
   "page": "nav",
   "tags": [
    "win"
   ],
   "expect": "each page loads fast, URL hash changes, Back works",
   "actions": [
    {
     "do": "goto",
     "path": "/#home"
    },
    {
     "do": "click",
     "sel": "role=link[name=\"Tickets\"]"
    },
    {
     "do": "expect_url",
     "contains": "#"
    },
    {
     "do": "click",
     "sel": "role=link[name=\"Settings\"]"
    },
    {
     "do": "expect_url",
     "contains": "#"
    },
    {
     "do": "back"
    },
    {
     "do": "click",
     "sel": "role=link[name=/^Home/]"
    },
    {
     "do": "expect_text",
     "text": "Needs you"
    }
   ]
  },
  {
   "id": "A03",
   "name": "New ticket: empty submit shows an inline error, Esc closes",
   "quick": true,
   "page": "new-ticket",
   "expect": "empty title is refused in words next to the field; Esc closes the dialog",
   "actions": [
    {
     "do": "goto",
     "path": "/#home"
    },
    {
     "do": "click",
     "sel": "#new-ticket"
    },
    {
     "do": "wait",
     "ms": 300
    },
    {
     "do": "press",
     "key": "Enter",
     "optional": true
    },
    {
     "do": "press",
     "key": "Escape"
    }
   ]
  },
  {
   "id": "A04",
   "name": "New ticket with title and note",
   "quick": true,
   "page": "tickets",
   "expect": "ticket appears on Home and in Tickets",
   "actions": [
    {
     "do": "goto",
     "path": "/#home"
    },
    {
     "do": "click",
     "sel": "#new-ticket"
    },
    {
     "do": "fill",
     "sel": "label=Title",
     "value": "E2E ticket {{stamp}}"
    },
    {
     "do": "press",
     "key": "Enter"
    },
    {
     "do": "wait",
     "ms": 1500
    },
    {
     "do": "expect_text",
     "text": "E2E ticket"
    }
   ]
  },
  {
   "id": "A05",
   "name": "Ticket page of the fixture ticket",
   "quick": true,
   "page": "ticket",
   "expect": "the ticket page shows title, status, tasks",
   "actions": [
    {
     "do": "goto",
     "path": "/#ticket/{{ticket_id}}"
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "expect_text",
     "text": "{{ticket_title}}"
    }
   ]
  },
  {
   "id": "A06",
   "name": "Settings page",
   "page": "settings",
   "expect": "Settings loads with the agent choice and add-ons",
   "actions": [
    {
     "do": "goto",
     "path": "/#settings"
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "expect_text",
     "text": "Settings"
    }
   ]
  },
  {
   "id": "A07",
   "name": "Add-on tabs: Automation, Focus, Relay",
   "page": "addons",
   "expect": "each add-on tab loads its page",
   "actions": [
    {
     "do": "click",
     "sel": "role=link[name=\"Automation\"]"
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "click",
     "sel": "role=link[name=\"Focus\"]"
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "click",
     "sel": "role=link[name=\"Relay\"]"
    },
    {
     "do": "wait",
     "ms": 800
    }
   ]
  },
  {
   "id": "A08",
   "name": "Origin check: a foreign page cannot act",
   "page": "api",
   "noshot": true,
   "quick": true,
   "expect": "POST /api/act with a foreign Origin is refused",
   "actions": [
    {
     "do": "goto",
     "path": "/"
    },
    {
     "do": "expect_status",
     "method": "POST",
     "path": "/api/act",
     "headers": {
      "Origin": "http://evil.example"
     },
     "body": {
      "op": "log",
      "args": {}
     },
     "status": [
      400,
      403
     ]
    }
   ]
  },
  {
   "id": "A10",
   "name": "Status menu offers Backlog, Ready, Working, Waiting, Review, Done; pick Working",
   "page": "home",
   "expect": "the status chip changes to Doing and stays after reload",
   "actions": [
    {
     "do": "goto",
     "path": "/#tickets"
    },
    {
     "do": "wait",
     "ms": 800
    },
    {
     "do": "click",
     "sel": "[data-key^='ticket-']:has-text('E2E ticket') summary >> nth=0"
    },
    {
     "do": "expect_text",
     "text": "Backlog"
    },
    {
     "do": "expect_text",
     "text": "Ready"
    },
    {
     "do": "expect_text",
     "text": "Review"
    },
    {
     "do": "click",
     "sel": "role=menuitemradio[name='Working']"
    },
    {
     "do": "wait",
     "ms": 1200
    },
    {
     "do": "reload"
    },
    {
     "do": "expect_text",
     "text": "Working"
    }
   ]
  },
  {
   "id": "A11",
   "name": "Tickets: List and Board",
   "page": "tickets",
   "expect": "both views show the tickets; the choice survives a reload",
   "actions": [
    {
     "do": "goto",
     "path": "/#tickets"
    },
    {
     "do": "click",
     "sel": "role=button[name='Board']"
    },
    {
     "do": "wait",
     "ms": 500
    },
    {
     "do": "reload"
    },
    {
     "do": "click",
     "sel": "role=button[name='List']"
    },
    {
     "do": "wait",
     "ms": 500
    }
   ]
  },
  {
   "id": "A27",
   "name": "Tickets board view (the shot is taken on the Board)",
   "page": "tickets-board",
   "expect": "one column per screen at 720 and 390 (opens on the first column with tickets), chips show counts, nothing cut off at the right",
   "actions": [
    {
     "do": "goto",
     "path": "/#tickets"
    },
    {
     "do": "eval",
     "js": "(async () => { const get = async () => (await (await fetch('/api/state', {cache:'no-store'})).json()).tickets || []; let ts = (await get()).filter(t => t.status !== 'dropped'); const want = ['active', 'review']; for (let i = 0; i < want.length && i < ts.length; i++) { if (ts.some(t => t.status === want[i])) continue; const t = ts.find(t => t.status === 'open'); if (!t) break; await fetch('/api/act', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({op:'ticket.patch', args:{ticket:t.id, data:{status:want[i]}, if_revision:t.revision}})}); ts = (await get()).filter(t => t.status !== 'dropped'); } return ts.map(t => t.status).join(','); })()",
     "store": "board_fixture"
    },
    {
     "do": "reload"
    },
    {
     "do": "click",
     "sel": "role=button[name='Board']"
    },
    {
     "do": "wait_for",
     "sel": ".kanban-col.is-shown .ticket-card",
     "timeout": 10000
    },
    {
     "do": "wait_for",
     "sel": ".status-jumps button[aria-pressed='true']",
     "state": "attached"
    },
    {
     "do": "expect_text",
     "text": "Review"
    }
   ]
  },
  {
   "id": "A28",
   "name": "Focus inside the dashboard (iframe) shows a CLI status change within 1 s",
   "page": "focus-embedded",
   "expect": "change the ticket status through the CLI; the embedded Focus page shows it in under 1 s",
   "actions": [
    {
     "do": "goto",
     "path": "/#open/focus/t/{{ticket_id}}"
    },
    {
     "do": "wait_for",
     "sel": "body",
     "frame": "iframe.embed",
     "timeout": 10000
    },
    {
     "do": "shell",
     "cmd": "{{setstatus}}",
     "args": [
      "ready"
     ]
    },
    {
     "do": "wait",
     "ms": 2500
    },
    {
     "do": "shell",
     "cmd": "{{setstatus}}",
     "args": [
      "review"
     ]
    },
    {
     "do": "expect_text",
     "text": "Review",
     "frame": "iframe.embed",
     "timeout": 1000
    }
   ]
  },
  {
